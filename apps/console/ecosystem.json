{
  "apps": [
    {
      "name": "console",
      "cwd": "./",
      "script": "node_modules/next/dist/bin/next",
      "args": "start -p 3000",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "out_file": "../../logs/console.out.log",
      "error_file": "../../logs/console.err.log"
    }
  ]
}
