{
  "name": "eventflow",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:console",
    "build:console": "npm run build -w apps/console",
    "dev:console": "npm run dev -w apps/console",
    "scaffold:all": "node scripts/scaffold-routes.mjs apps/console && node scripts/scaffold-routes.mjs apps/partner",
    "gen": "plop",
    "gen:module": "plop module",
    "gen:app": "plop app",
    "gen:register": "plop register",
    "gen:unregister": "plop unregister",
    "lint": "eslint"
  },
  "dependencies": {
    "@rwtechnology/eventflow-design-system": "^0.1.14",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "plop": "^4.0.5",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
