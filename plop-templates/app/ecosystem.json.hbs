{
  "apps": [
    {
      "name": "{{name}}",
      "cwd": "./",
      "script": "node_modules/next/dist/bin/next",
      "args": "start -p {{port}}",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": "{{port}}"
      },
      "out_file": "../../logs/{{name}}.out.log",
      "error_file": "../../logs/{{name}}.err.log"
    }
  ]
}
